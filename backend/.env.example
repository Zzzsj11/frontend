# Server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173

# Persistence
DATABASE_URL=postgresql+asyncpg://mvagent:mvagent@127.0.0.1:5433/mvagent
REDIS_URL=redis://127.0.0.1:6380/0
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_SECURE=false

# OpenAI-compatible chat/storyboard model
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_API_MODE=openai
STORYBOARD_GENERATION_CONCURRENCY=4

# Yinghe image generation
IMAGE_API_BASE_URL=https://api-aigc.fzyinghe.com
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2

# Yinghe video generation
VIDEO_API_BASE_URL=https://api-aigc.fzyinghe.com
VIDEO_API_KEY=
VIDEO_MODEL=doubao-seedance-2.0

# All persistent media is stored in TOS. There is no local media backend.
STORAGE_BACKEND=tos
TOS_ENDPOINT=
TOS_REGION=
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
TOS_REFERENCE_BUCKET=media-generate
TOS_VIDEO_ARCHIVE_BUCKET=media-generate
TOS_REFERENCE_PREFIX=mv-agent/references
TOS_VIDEO_ARCHIVE_PREFIX=mv-agent/generated-videos
TOS_PUBLIC_BUCKET_DOMAIN=
