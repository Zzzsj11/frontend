# Server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173

# Persistence
DATABASE_URL=postgresql+asyncpg://mvagent:mvagent@127.0.0.1:5433/mvagent
REDIS_URL=redis://127.0.0.1:6380/0
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_SECURE=false

# OpenAI-compatible chat/storyboard model
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_API_MODE=openai
STORYBOARD_GENERATION_CONCURRENCY=4
EXPORT_CONCURRENCY=4
EXPORT_PER_USER_CONCURRENCY=2
# 单次导出的素材下载并发，以及 ZIP 上传到 TOS 的分片并发/分片大小
EXPORT_DOWNLOAD_CONCURRENCY=20
EXPORT_UPLOAD_CONCURRENCY=4
EXPORT_UPLOAD_PART_SIZE_MB=16

# Host monitoring: default-route public egress, calendar month, binary GiB (1024^3 bytes)
SERVER_TRAFFIC_QUOTA_GIB=300
SERVER_MONITOR_TIMEZONE=Asia/Shanghai
SERVER_METRIC_RETENTION_DAYS=35

# Default limits for newly created accounts. Each account can be adjusted in admin.
# Counters reset at natural-day midnight in the configured timezone.
DAILY_QUOTA_TIMEZONE=Asia/Shanghai
DAILY_CHAT_LIMIT=1000
DAILY_IMAGE_LIMIT=100
DAILY_VIDEO_LIMIT=100

# Yinghe image generation
IMAGE_API_BASE_URL=https://api-aigc.fzyinghe.com
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2

# Yinghe video generation
VIDEO_API_BASE_URL=https://api-aigc.fzyinghe.com
VIDEO_API_KEY=
VIDEO_MODEL=doubao-seedance-2.0

# Yinghe business account balance (server-side only)
BUSINESS_API_KEY=
BUSINESS_USER_ID=
BUSINESS_BALANCE_URL=https://api-aigc.fzyinghe.com/business/reconcile/balance
BUSINESS_BALANCE_TIMEOUT=10
BUSINESS_BALANCE_CACHE_SECONDS=30

# All persistent media is stored in TOS. There is no local media backend.
STORAGE_BACKEND=tos
TOS_ENDPOINT=
TOS_REGION=
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
TOS_REFERENCE_BUCKET=media-generate
TOS_VIDEO_ARCHIVE_BUCKET=media-generate
TOS_REFERENCE_PREFIX=mv-agent/references
TOS_VIDEO_ARCHIVE_PREFIX=mv-agent/generated-videos
TOS_PUBLIC_BUCKET_DOMAIN=
