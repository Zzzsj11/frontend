# Server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173

# Persistence
DATABASE_URL=postgresql+asyncpg://mvagent:mvagent@127.0.0.1:5433/mvagent
REDIS_URL=redis://127.0.0.1:6380/0
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# 生产 HTTPS 必须设为 true；测试账号由运维显式授权。
REFRESH_COOKIE_SECURE=false
AGENT_TEST_USERNAMES=
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# OpenAI-compatible chat/storyboard model
LLM_CHANNEL=all-in-one
ALL_IN_ONE_BASE_URL=https://mg.epaipix.com
ALL_IN_ONE_API_KEY=
ALL_IN_ONE_SYSTEM_KEY=false
ALL_IN_ONE_LLM_MODEL=gemini-3.8-flash-all-in-one
GENERAL_OUTLINE_LLM_MODEL=gemini-3.8-flash-all-in-one
LLM_API_MODE=openai
# 分镜大纲协议：v2 使用紧凑结构化输出；紧急回滚时改为 v1。
OUTLINE_PROTOCOL_VERSION=v2
STORYBOARD_GENERATION_CONCURRENCY=64
TEXT_GENERATION_CONCURRENCY=8
# 默认保持 Gemini；显式开启后才允许切换备用文本模型。
LLM_FAILOVER_ENABLED=false
STORYBOARD_LINE_TIMEOUT_SECONDS=720
EXPORT_CONCURRENCY=4
EXPORT_PER_USER_CONCURRENCY=2
# 单次导出的素材下载并发，以及 ZIP 上传到 TOS 的分片并发/分片大小
EXPORT_DOWNLOAD_CONCURRENCY=20
EXPORT_UPLOAD_CONCURRENCY=4
EXPORT_UPLOAD_PART_SIZE_MB=16

# Host monitoring: default-route public egress, calendar month, binary GiB (1024^3 bytes)
SERVER_TRAFFIC_QUOTA_GIB=300
SERVER_MONITOR_TIMEZONE=Asia/Shanghai
SERVER_METRIC_RETENTION_DAYS=35

# Default limits for newly created accounts. Each account can be adjusted in admin.
# Counters reset at natural-day midnight in the configured timezone.
DAILY_QUOTA_TIMEZONE=Asia/Shanghai
DAILY_CHAT_LIMIT=1000
DAILY_IMAGE_LIMIT=1000
DAILY_VIDEO_LIMIT=1000
IMAGE_GENERATION_CONCURRENCY=200
VIDEO_GENERATION_CONCURRENCY=200
PROVIDER_GENERATION_WORKER_CONCURRENCY=200
IMAGE_RESULT_PROCESSING_CONCURRENCY=40
VIDEO_RESULT_PROCESSING_CONCURRENCY=20

# Image generation
IMAGE_MODEL=nano-banana-2.1-all-in-one
# 人物身份参考卡独立默认模型；场景图仍按用户选择生成。
DIGITAL_HUMAN_IMAGE_MODEL=nano-banana-2.1-all-in-one

# Video generation
VIDEO_MODEL=doubao-seedance-2.0-all-in-one

# Balance request coalescing (server-side only)
BALANCE_FORCE_COALESCE_SECONDS=10

# All persistent media is stored in TOS. There is no local media backend.
STORAGE_BACKEND=tos
TOS_ENDPOINT=
TOS_REGION=
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
TOS_REFERENCE_BUCKET=media-generate
TOS_VIDEO_ARCHIVE_BUCKET=media-generate
TOS_REFERENCE_PREFIX=mv-agent/references
TOS_VIDEO_ARCHIVE_PREFIX=mv-agent/generated-videos
TOS_PUBLIC_BUCKET_DOMAIN=

# Admin multi-reference prompt optimizer. Secrets stay server-side.
PROMPT_OPTIMIZER_TIMEOUT=300

# Optional independent model service (leave blank to preserve direct provider routing).
# Internal API key only; supplier keys belong to model-service once migrated.
MODEL_GATEWAY_URL=
MODEL_GATEWAY_API_KEY=
