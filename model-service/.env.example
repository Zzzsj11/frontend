# public-api and worker only; create .env.public for Docker.
DATABASE_URL=postgresql+asyncpg://model_service:CHANGE_ME@postgres:5432/model_service
YINGHE_BASE_URL=https://api-aigc.fzyinghe.com
YINGHE_API_KEY=
YINGHE_LLM_BASE_URL=https://ai-aigc.fzyinghe.com
YINGHE_LLM_API_KEY=
YSEEAI_BASE_URL=https://api-aigc.yseeai.com
YSEEAI_API_KEY=
TOAPIS_API_KEY=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_REFERENCE_BUCKET=
TOS_VIDEO_BUCKET=
WORKER_CONCURRENCY=16
# admin-api only; create .env.admin with its own database credential.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
# Local Fake-IP DNS workaround; leave disabled on ordinary production networks.
MEDIA_DNS_OVER_HTTPS=false
MEDIA_DNS_PROXY=
# Shared channel caps, in addition to per-model and per-client caps.
YINGHE_CONCURRENCY=16
YSEEAI_CONCURRENCY=16

# 渠道业务凭据仅供公开执行服务/Worker 使用，不能放进 .env.admin。
# 国内、海外商户和调用 Key 必须分别匹配；空值表示未配置。
YINGHE_BUSINESS_USER_ID=
YINGHE_BUSINESS_API_KEY=
YINGHE_BUSINESS_BASE_URL=https://api-aigc.fzyinghe.com
YSEEAI_BUSINESS_USER_ID=
YSEEAI_BUSINESS_API_KEY=
YSEEAI_BUSINESS_BASE_URL=https://api-aigc.yseeai.com
