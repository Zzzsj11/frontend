# Copy to .env.production on the current test server. This historical filename
# means "server test environment" until v1.0.0. Never commit real values.
# Images are built and versioned locally on the server.
REGISTRY=mvagent-local
JWT_SECRET=replace-with-at-least-32-random-characters
POSTGRES_DB=mvagent
POSTGRES_USER=mvagent
POSTGRES_PASSWORD=replace-with-strong-random-password
FRONTEND_PORT=80
BACKEND_PORT=8000
# Enable only after worker containers are deployed from the same versioned image.
JOB_EXECUTION_MODE=worker
COMPOSE_PROFILES=workers
IMAGE_WORKER_CONCURRENCY=4
VIDEO_WORKER_CONCURRENCY=4
EXPORT_WORKER_CONCURRENCY=1
CHAT_WORKER_CONCURRENCY=2
STORYBOARD_WORKER_CONCURRENCY=2
WORKER_STALE_SECONDS=180

# Production startup requires HTTPS and Secure refresh cookies.
# Export TLS_DOMAIN, TLS_CERT_DIR and DEPLOY_TLS=1 when invoking deploy-local-images.sh.
