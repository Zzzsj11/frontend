{
  "name": "mvagent",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint src tests e2e vite.config.ts playwright.config.ts",
    "format": "prettier --write src tests e2e '*.{json,ts,js,md}'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real": "REAL_GENERATION_E2E=1 playwright test e2e/full-real-generation.spec.ts --workers=1",
    "test:e2e:real:general": "REAL_GENERATION_E2E=1 REAL_E2E_PHASE=general playwright test e2e/full-real-generation.spec.ts --workers=1",
    "test:e2e:real:export": "REAL_GENERATION_E2E=1 REAL_E2E_PHASE=general-export playwright test e2e/full-real-generation.spec.ts --workers=1",
    "test:remote:api": "REMOTE_API_E2E=1 playwright test e2e/remote-api.spec.ts --workers=1",
    "test:remote:frontend": "REMOTE_FRONTEND_E2E=1 playwright test e2e/remote-frontend.spec.ts --workers=1",
    "test:remote:frontend:real": "REAL_GENERATION_E2E=1 playwright test e2e/full-real-generation.spec.ts --workers=1",
    "test:remote:all": "npm run test:remote:api && npm run test:remote:frontend",
    "test:admin:api": "ADMIN_API_E2E=1 playwright test e2e/admin-api.spec.ts --workers=1",
    "test:admin:frontend": "ADMIN_CONSOLE_E2E=1 playwright test e2e/admin-console.spec.ts --workers=1",
    "test:admin": "npm run test:admin:api && npm run test:admin:frontend",
    "test:remote:all:real": "npm run test:remote:api && npm run test:remote:frontend && npm run test:remote:frontend:real",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
